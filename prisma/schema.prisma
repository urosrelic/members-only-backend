generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model clubhouse {
  id              String            @id @default(uuid()) @db.Uuid
  name            String            @db.VarChar(255)
  owner_id        String            @db.Uuid
  user            user              @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clubhouse_users clubhouse_users[]
  post            post[]
}

model clubhouse_users {
  clubhouse_id String    @db.Uuid
  user_id      String    @db.Uuid
  clubhouse    clubhouse @relation(fields: [clubhouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user         user      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, clubhouse_id])
}

model comment {
  id         String   @id @default(uuid()) @db.Uuid
  post_id    String   @db.Uuid
  user_id    String   @db.Uuid
  body       String
  created_at DateTime @db.Timestamptz(6)
  post       post     @relation(fields: [post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       user     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model post {
  id               String             @id @default(uuid()) @db.Uuid
  post_text        String
  user_id          String             @db.Uuid
  clubhouse_id     String             @db.Uuid
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @updatedAt @db.Timestamptz(6)
  comment          comment[]
  clubhouse        clubhouse          @relation(fields: [clubhouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user             user               @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_liked_posts user_liked_posts[]
  user_saved_posts user_saved_posts[]
}

model role {
  id         String       @id @default(uuid()) @db.Uuid
  name       String       @unique
  user_roles user_roles[]
}

model user {
  id               String             @id @default(uuid()) @db.Uuid
  first_name       String             @db.VarChar(255)
  last_name        String             @db.VarChar(255)
  email            String             @unique @db.VarChar(255)
  password         String
  profile_picture  String?
  clubhouse        clubhouse[]
  clubhouse_users  clubhouse_users[]
  comment          comment[]
  post             post[]
  user_liked_posts user_liked_posts[]
  user_roles       user_roles[]
  user_saved_posts user_saved_posts[]
}

model user_liked_posts {
  user_id String @db.Uuid
  post_id String @db.Uuid
  post    post   @relation(fields: [post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user    user   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, post_id])
}

model user_roles {
  user_id String @db.Uuid
  role_id String @db.Uuid
  role    role   @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user    user   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, role_id])
}

model user_saved_posts {
  user_id String @db.Uuid
  post_id String @db.Uuid
  post    post   @relation(fields: [post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user    user   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, post_id])
}
